{
  "name": "bookworm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BookWorm e-bookstore monorepo",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w packages/api",
    "dev:web": "npm run dev -w packages/web",
    "build": "npm run build -w packages/web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w packages/api && npm run test:coverage -w packages/web",
    "db:migrate": "npm run db:migrate -w packages/api",
    "db:seed": "npm run db:seed -w packages/api",
    "db:reset": "npm run db:reset -w packages/api",
    "db:studio": "npm run db:studio -w packages/api",
    "spec:validate": "npm run spec:validate -w packages/api"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.4",
    "vitest": "^3.2.7"
  }
}
